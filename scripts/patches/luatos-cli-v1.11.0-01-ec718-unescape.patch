+    #[test]
+    fn ec718_decoder_ec718_escape() {
+        // 实测抓包：日志里的 "QQ}QQ~QQ]QQ" 收到的是 51 51 7D 01 51 51 7D 02 51 51 5D 51 51
+        let mut decoder = Ec718LogDecoder::new();
+        let mut frame = vec![0x7E];
+        frame.extend_from_slice(&1000u32.to_le_bytes());
+        frame.extend_from_slice(&0u32.to_le_bytes());
+        frame.extend_from_slice(&0u32.to_le_bytes());
+        frame.extend_from_slice(&[0x51, 0x51, 0x7D, 0x01, 0x51, 0x51, 0x7D, 0x02, 0x51, 0x51, 0x5D, 0x51, 0x51, 0x00]);
+        frame.push(0x7E);
+
+        let entries = decoder.feed(&frame);
+        assert_eq!(entries.len(), 1);
+        assert_eq!(entries[0].message, "QQ}QQ~QQ]QQ");
+    }
+
+    #[test]
+    fn ec718_decoder_json_payload() {
+        // 修复前 `{"type":"sync"}` 会被解成 `{"type":"sync"!`
+        let mut decoder = Ec718LogDecoder::new();
+        let mut frame = vec![0x7E];
+        frame.extend_from_slice(&1000u32.to_le_bytes());
+        frame.extend_from_slice(&0u32.to_le_bytes());
+        frame.extend_from_slice(&0u32.to_le_bytes());
+        for &b in br#"{"type":"sync"}"# {
+            match b {
+                0x7D => frame.extend_from_slice(&[0x7D, 0x01]),
+                0x7E => frame.extend_from_slice(&[0x7D, 0x02]),
+                _ => frame.push(b),
+            }
+        }
+        frame.push(0x00);
+        frame.push(0x7E);
+
+        let entries = decoder.feed(&frame);
+        assert_eq!(entries.len(), 1);
+        assert_eq!(entries[0].message, r#"{"type":"sync"}"#);
+    }
