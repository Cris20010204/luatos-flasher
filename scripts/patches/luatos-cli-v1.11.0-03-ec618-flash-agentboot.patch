+/// AP flash 的 XIP 映射基址。
+const AP_XIP_BASE: u32 = 0x800000;
+
+fn ap_raw_addr(addr: u32) -> u32 {
+    addr.checked_sub(AP_XIP_BASE).unwrap_or(addr)
+}
+
+/// EC618 的分区写法，照固件包里 config_ec618_usb.ini（LuaTools 调 FlashToolCLI 用的配置）：
+///   - BL / AP 写 AP flash，地址是不带 0x800000 的原始地址（0x4000 / 0x24000）
+///   - CP 在独立的 CP flash 上，从 0 开始（EC7xx 的 CP 在 AP flash 里，这是两者最大的区别）
+///   - 脚本按 flexfile 写 AP flash 的 script_addr（如 0x2CC000）
+///
+/// 配置里另有两份 RF 表（MergeRfTable_ec618.bin → CP flash 0xE7000 / 0xCE000），不在 binpkg 里，这里不写，保留模组上原有的。
+fn entry_to_burn_type_ec618(entry: &BinpkgEntry) -> Option<(BurnImageType, u8, u32)> {
+    if entry.name.eq_ignore_ascii_case("script") {
+        return Some((BurnImageType::FlexFile, STYPE_AP_FLASH, ap_raw_addr(entry.addr)));
+    }
+    match entry.image_type.trim().to_ascii_uppercase().as_str() {
+        "BL" => Some((BurnImageType::Bootloader, STYPE_AP_FLASH, ap_raw_addr(entry.addr))),
+        "AP" => Some((BurnImageType::Ap, STYPE_AP_FLASH, ap_raw_addr(entry.addr))),
+        "CP" => Some((BurnImageType::Cp, STYPE_CP_FLASH, 0)),
+        _ => None,
+    }
+}
