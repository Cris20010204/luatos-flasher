+// EC618（Air780E / Air780EG）的 AgentBoot，取自 FlashToolCLI 的 ec618_products。
+// 只在 .soc 没带 agentboot_*.bin 时使用（LuatOS 的 EC618 固件包一般自带 agentboot_usb.bin）。
+const AGENTBOOT_EC618_USB: &[u8] = include_bytes!("../../../refs/origin_tools/ec_download/product_sets/ec618_products/common_data/agentboot_usb/agentboot.bin");
+const AGENTBOOT_EC618_UART: &[u8] = include_bytes!("../../../refs/origin_tools/ec_download/product_sets/ec618_products/common_data/agentboot_uart/agentboot.bin");
+
+/// AgentBoot 是几十 KB 的程序。没装 git-lfs 就编译时，include_bytes! 拿到的是 130 字节左右的 LFS 指针文本，
+/// 下载给模组后模组会跑飞，表现为写第一个分区时 “Broken pipe”。在动设备之前拦下来。
+fn check_agentboot(data: &[u8], what: &str) -> Result<()> {
+    if data.starts_with(b"version https://git-lfs") || data.len() < 4096 {
+        bail!(
+            "AgentBoot ({what}) 无效：只有 {} 字节{}。luatos-cli 编译时没拿到 Git LFS 里的二进制文件，请重新编译",
+            data.len(),
+            if data.starts_with(b"version https://git-lfs") { "，内容是 Git LFS 指针" } else { "" }
+        );
+    }
+    Ok(())
+}
 
