+    #[test]
+    fn ec618_partitions_follow_vendor_config() {
+        // Air780EG V1124 的 binpkg：BL 0x4000、AP 0x24000、CP 0（CP flash），脚本 0x2CC000
+        let bl = entry_to_burn_type_ec618(&pkg_entry("ap_bootloader", "BL", 0x4000)).unwrap();
+        assert_eq!(bl, (BurnImageType::Bootloader, STYPE_AP_FLASH, 0x4000));
+        let ap = entry_to_burn_type_ec618(&pkg_entry("ap", "AP", 0x24000)).unwrap();
+        assert_eq!(ap, (BurnImageType::Ap, STYPE_AP_FLASH, 0x24000));
+        let cp = entry_to_burn_type_ec618(&pkg_entry("cp-demo-flash", "CP", 0)).unwrap();
+        assert_eq!(cp, (BurnImageType::Cp, STYPE_CP_FLASH, 0));
+        let script = entry_to_burn_type_ec618(&pkg_entry("script", "AP", 0x2CC000)).unwrap();
+        assert_eq!(script, (BurnImageType::FlexFile, STYPE_AP_FLASH, 0x2CC000));
+        // 带 0x800000 映射基址的地址也还原成原始地址
+        let ap_xip = entry_to_burn_type_ec618(&pkg_entry("ap", "AP", 0x824000)).unwrap();
+        assert_eq!(ap_xip.2, 0x24000);
+        assert!(entry_to_burn_type_ec618(&pkg_entry("unknown", "XX", 0)).is_none());
+    }
