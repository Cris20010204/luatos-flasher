+    fn agentboot(&self, port_type: Ec718PortType) -> Result<(&[u8], &'static str)> {
+        let (bundled, builtin, builtin_name) = match (self.is_ec618(), port_type) {
+            (true, Ec718PortType::Usb) => (&self.agentboot_usb, AGENTBOOT_EC618_USB, "内置 ec618_usb"),
+            (true, Ec718PortType::Uart) => (&self.agentboot_uart, AGENTBOOT_EC618_UART, "内置 ec618_uart"),
+            (false, Ec718PortType::Usb) => (&self.agentboot_usb, AGENTBOOT_EC718M_USB, "内置 ec718m_usb"),
+            (false, Ec718PortType::Uart) => (&self.agentboot_uart, AGENTBOOT_EC718M_UART, "内置 ec718m_uart"),
+        };
+        let (data, from) = match bundled {
+            Some(d) => (d.as_slice(), "SOC 自带"),
+            None => (builtin, builtin_name),
+        };
+        check_agentboot(data, from)?;
+        Ok((data, from))
+    }
+
+    /// AgentBoot 加载后使用的波特率（写进镜像头）。EC718 沿用 info.json 的 force_br；
+    /// EC618 按固件包里下载配置的 agbaud（官方配置是 921600）。
+    fn agent_baud(&self) -> u32 {
+        if self.is_ec618() {
+            self.agbaud.unwrap_or(921600)
+        } else {
+            self.force_br
+        }
+    }
+}
+
+/// 从 config_*.ini 文本里取 `agbaud = N`。
+fn ini_agbaud(text: &str) -> Option<u32> {
+    text.lines().find_map(|line| {
+        let line = line.trim();
+        if line.starts_with(';') || line.starts_with('#') {
+            return None;
+        }
+        let (k, v) = line.split_once('=')?;
+        if k.trim().eq_ignore_ascii_case("agbaud") {
+            v.trim().parse().ok()
+        } else {
+            None
+        }
+    })
+}
